# Dinheirama runtime configuration.
# Copy to .env locally. In production, inject these through Kubernetes/ArgoCD secrets or sealed secrets.

# Local AI. Keep default for a local Ollama sidecar/host.
OLLAMA_HOST=http://127.0.0.1:11434

# fast-news semantic/RAG API. Dinheirama calls: FAST_NEWS_URL/api/rag/search?q=...
FAST_NEWS_URL=https://fast-news.example.local

# Comma-separated RSS/Atom feeds for market news.
MARKET_NEWS_FEEDS=https://example.com/markets.rss

# Comma-separated paper feeds. Optional: if empty, research uses the built-in arXiv query fallback.
PAPER_FEEDS=

# Telegram daily radar. Never commit real tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_UTC_HOUR=11

# Training / ML model paths (optional: defaults to /data/training and /data/models inside container)
TRAINING_DATA_DIR=/data/training
MODEL_DIR=/data/models
