# Dinheirama runtime configuration.
# Copy to .env locally. In production, inject these through Kubernetes/ArgoCD secrets or sealed secrets.

# LLM via LiteLLM (OpenAI-compatible). Use the app's own virtual key.
LITELLM_BASE_URL=http://litellm.ai.svc.cluster.local:4000/v1
LITELLM_API_KEY=
LLM_MODEL=cloud/auto

# fast-news semantic/RAG API. Dinheirama calls: FAST_NEWS_URL/api/rag/search?q=...
FAST_NEWS_URL=https://fast-news.example.local

# Comma-separated RSS/Atom feeds for market news.
MARKET_NEWS_FEEDS=https://example.com/markets.rss

# Comma-separated paper feeds. Optional: if empty, research uses the built-in arXiv query fallback.
PAPER_FEEDS=

# Optional B3 quote fallback via brapi.dev. Without a token, only the provider's demo tickers respond.
BRAPI_TOKEN=

# Telegram daily radar. Never commit real tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_UTC_HOUR=11

# Monte Carlo (optional): history window and annual risk-free rate used in the simulated Sharpe.
MC_LOOKBACK_DAYS=365
MC_RISK_FREE_RATE=0.105

# Training / ML model paths (optional: defaults to /data/training and /data/models inside container)
TRAINING_DATA_DIR=/data/training
MODEL_DIR=/data/models

# Camada quantitativa (fatores, backtest, carteira robusta, IPS, diario de decisoes).
# Pasta de dados persistentes: ips.json, journal.json, fundamentals_pit.csv. Default: ALERTS_DIR ou ../data.
QUANT_DATA_DIR=/data/quant
# Premissas do DCF (nominais em BRL; ajuste a premissas proprias, sao muito sensiveis).
DCF_RISK_FREE=0.115
DCF_EQUITY_RISK_PREMIUM=0.055
# Origens extras aceitas nas rotas que gravam estado (separadas por virgula). Por padrao, so a mesma origem.
ALLOWED_ORIGINS=
